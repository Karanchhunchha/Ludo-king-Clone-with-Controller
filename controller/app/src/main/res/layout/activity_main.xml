<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="22dp"
        android:paddingBottom="36dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controller by Karan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#F2F3F7"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ludo dice controller over Bluetooth LE"
            android:textSize="13sp"
            android:textColor="#8B93A7"
            android:layout_marginBottom="16dp" />

        <!-- 1. Connection Card -->
        <LinearLayout
            android:id="@+id/cardConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDevName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No device"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#F2F3F7"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvDevSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan and pick any BLE device"
                        android:textSize="13sp"
                        android:textColor="#9AA0B2"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#3DDC84"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF7A59"
                    android:background="#33FF7A59"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Scan devices"
                    android:textColor="#0F1115"
                    android:backgroundTint="#F2F3F7"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Disconnect"
                    android:textColor="#FF9E94"
                    android:backgroundTint="#2A1D1F"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btnQuick"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="↻ Reconnect last device"
                android:textColor="#9FC4F5"
                android:backgroundTint="#1D2942"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Nearby Devices Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby devices"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F2F3F7"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvDeviceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap Scan to look for devices"
                android:textSize="12sp"
                android:textColor="#9AA0B2"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layoutDeviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 3. Choose Your Colour Card (Blue first, then Red, Green, Yellow) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your colour"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F2F3F7"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Blue (first) -->
                <LinearLayout
                    android:id="@+id/btnColBlue"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_blue"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blue"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Red -->
                <LinearLayout
                    android:id="@+id/btnColRed"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_red"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Green -->
                <LinearLayout
                    android:id="@+id/btnColGreen"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_green"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Green"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Yellow -->
                <LinearLayout
                    android:id="@+id/btnColYellow"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_yellow"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yellow"
                        android:textStyle="bold"
                        android:textColor="#3A2A00"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Dice Stage -->
        <LinearLayout
            android:id="@+id/layoutStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvStageDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="18sp"
                    android:textColor="#3B7DDD"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Blue's dice"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#F2F3F7" />

                <TextView
                    android:id="@+id/tvLastAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nothing sent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#9AA0B2"
                    android:background="#26303B4D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 6 Dice Grid (3 columns x 2 rows) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignMargins">

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />

                <com.bletestclient.ui.DiceView
                    android:id="@+id/die6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp" />
            </GridLayout>

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a dice face to send Blue + value to the game."
                android:textSize="13sp"
                android:textColor="#9AA0B2"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 5. Sent Messages History Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sent messages"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F2F3F7" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="CLEAR"
                    android:textSize="11sp"
                    android:textColor="#9AA0B2"
                    android:backgroundTint="#262B36" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Messages you send will appear here."
                    android:textColor="#9AA0B2"
                    android:textSize="14sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
